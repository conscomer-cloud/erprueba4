# ==========================================================
# CONSCORE ERP IA — variables de entorno
# Copia este archivo como .env y ajusta los valores.
# ==========================================================

# Secreto para firmar los tokens de sesión. OBLIGATORIO en producción.
# Mínimo 32 caracteres. Genéralo con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Si falta, se genera uno al vuelo y todas las sesiones se caen al reiniciar.
SESSION_SECRET=""

# Contraseña inicial de los usuarios sembrados en el primer arranque.
# Cámbiala antes de desplegar: el valor por defecto es público.
SEED_PASSWORD=""

# Ruta del archivo de base de datos. En Cloud Run apunta a un volumen
# persistente; el disco del contenedor se borra en cada reinicio.
DB_PATH="./data/conscore_db.json"

# Puerto de escucha. Cloud Run lo inyecta automáticamente.
PORT=3000

# Clave de la API de Gemini para el módulo de IA.
GEMINI_API_KEY=""

# URL pública donde se hospeda la aplicación.
APP_URL=""

# --- Banderas de compilación del cliente (solo si las necesitas) ---
# Muestra el simulador multiusuario, la prueba E2E y el selector de rol.
# VITE_ENABLE_DEV_TOOLS="false"
# Muestra los accesos rápidos en la pantalla de acceso.
# VITE_ENABLE_DEMO_LOGIN="false"
# Contraseña que usan esos accesos rápidos.
# VITE_DEMO_PASSWORD=""
